# ==========================================
# James Boh Macro Tracker 🥗 Configuration Template
# ==========================================

# Telegram Bot Token obtained from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# The exact title of your Google Sheet document
GOOGLE_SHEET_NAME=James Boh Macro Tracker

# Path to your Google Cloud Service Account JSON credentials file
# Place this file in the project root directory
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Timezone for timestamps and daily resets (e.g. Asia/Singapore, America/New_York, UTC)
TIMEZONE=Asia/Singapore

# Optional: List of authorized Telegram usernames (without @) or user IDs, separated by commas.
# If left empty, anyone who starts the bot can log.
# Example: ALLOWED_USERS=your_username,partner_username
ALLOWED_USERS=
